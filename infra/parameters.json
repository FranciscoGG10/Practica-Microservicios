{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "authServiceImage": {
      "type": "string",
      "defaultValue": "auth_service:latest",
      "metadata": {
        "description": "Docker image for the authentication service"
      }
    },
    "gameServiceImage": {
      "type": "string",
      "defaultValue": "game_service:latest",
      "metadata": {
        "description": "Docker image for the game service"
      }
    },
    "scoreServiceImage": {
      "type": "string",
      "defaultValue": "score_service:latest",
      "metadata": {
        "description": "Docker image for the score service"
      }
    },
    "frontendImage": {
      "type": "string",
      "defaultValue": "frontend:latest",
      "metadata": {
        "description": "Docker image for the frontend application"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "East US",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "myAppServicePlan",
      "metadata": {
        "description": "Name of the App Service Plan"
      }
    },
    "webAppName": {
      "type": "string",
      "defaultValue": "myWebApp",
      "metadata": {
        "description": "Name of the Web App"
      }
    }
  }
}